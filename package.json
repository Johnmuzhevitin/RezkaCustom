{
  "name": "rezka-custom",
  "version": "0.7.2",
  "private": true,
  "description": "Standalone Chromium port of HDrezka Improvement 2.1.8",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:myshows": "playwright test tests/browser/myshows.spec.mjs",
    "setup:git": "node tools/setup-git.mjs",
    "check": "node tools/check.mjs",
    "check:offline": "node tools/check.mjs",
    "check:browser": "npm run check:offline && npm run test:browser",
    "package": "node tools/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3"
  }
}
